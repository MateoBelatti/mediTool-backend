# Entorno (en Railway usar Production)
ASPNETCORE_ENVIRONMENT=Production

# JWT Configuration
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=
Jwt__AccessTokenExpirationMinutes=
Jwt__RefreshTokenExpirationDays=

# Database
# Formato para PostgreSQL gestionado de Railway:
# ConnectionStrings__DefaultConnection=Host=...;Port=...;Database=...;Username=...;Password=...
ConnectionStrings__DefaultConnection=

# CORS (origen del frontend; para más orígenes agregar __1, __2, etc.)
Cors__AllowedOrigins__0=

# Seed configuration
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=password
